# Copy to .env.local and fill in. For local Supabase (`npx supabase start` from the repo root),
# run `npx supabase status` to get these values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:58321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optimization backend (backend/), local only: uvicorn food_opt.api:app --port 8000
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8000
